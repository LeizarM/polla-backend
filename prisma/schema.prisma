generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
    output = "../node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model user {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username      String   @unique @db.VarChar(50)
  password      String   @db.VarChar(255)
  full_name     String   @db.VarChar(100)
  phone         String   @db.VarChar(20)
  // CI (cédula) es obligatorio pero NO único — varios users pueden
  // compartirlo (familia, etc.). Solo el username debe ser único.
  ci            String   @db.VarChar(20)
  role          String   @default("user") @db.VarChar(10)
  balance       Decimal  @default(0.00) @db.Decimal(12, 2)
  status        String   @default("active") @db.VarChar(10)
  fcm_token     String?  @db.VarChar(255)
  // ── 2FA (TOTP) — solo para admins por ahora ────────────────────────
  totp_secret   String?  @db.VarChar(64)    // base32 secret cifrado
  totp_enabled  Boolean  @default(false)
  // Anti-replay TOTP: último "step" (contador de 30s) aceptado en un login.
  // Un código de un step <= a este se rechaza → uso único dentro de su ventana.
  totp_last_step Int?
  // Anti brute-force PERSISTIDO (sobrevive reinicios y es compartido entre
  // instancias — antes era un Map en memoria, bypasseable reiniciando).
  failed_login_attempts Int       @default(0)
  locked_until           DateTime? @db.Timestamptz(6)
  // Última actividad autenticada — actualizado por el interceptor cada ~1 min.
  // Usado para "usuarios conectados" en /admin/notificaciones → Stats.
  last_seen_at  DateTime? @db.Timestamptz(6)
  // ── Avatar (foto de perfil) ────────────────────────────────────────────
  // Imagen comprimida en el cliente (~256px, <500KB). Se guarda BINARIA (bytea).
  // En los payloads de listas (roster/ranking) NO se selecciona `avatar` (los
  // bytes) — solo `avatar_updated_at` para saber si hay foto y cache-bustear la
  // URL `/api/users/:id/avatar`. Así las listas quedan livianas.
  avatar            Bytes?
  avatar_mime       String?   @db.VarChar(30)
  avatar_updated_at DateTime? @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  tickets                ticket[]
  group_bets             group_bet[]
  transactions           transaction[]
  final_bets             final_bet[]
  tournament_participants tournament_participant[]
  push_tokens            push_token[]

  @@index([username], map: "idx_user_username")
  @@index([role], map: "idx_user_role")
  @@index([ci], map: "idx_user_ci")
}

model team {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String   @db.VarChar(100)
  country    String   @db.VarChar(100)
  shield_url String?  @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  tournament_teams tournament_team[]
  match_a          match[]           @relation("team_a")
  match_b          match[]           @relation("team_b")
}

model tournament {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String   @db.VarChar(200)
  description       String?  @db.Text
  type              String   @db.VarChar(20)
  start_date        DateTime @db.Date
  end_date          DateTime @db.Date
  status            String   @default("draft") @db.VarChar(15)
  house_cut_pct     Decimal  @default(10.00) @db.Decimal(5, 2)
  min_bet           Decimal  @default(10.00) @db.Decimal(12, 2)
  max_bet           Decimal  @default(1000.00) @db.Decimal(12, 2)
  bet_per_matchday    Decimal   @default(10.00) @db.Decimal(12, 2)
  bet_final           Decimal   @default(5.00) @db.Decimal(12, 2)
  currency            String    @default("Bs") @db.VarChar(10)
  final_bet_deadline  DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  tournament_teams    tournament_team[]
  matchdays           matchday[]
  tournament_groups   tournament_group[]
  final_bets          final_bet[]
  participants        tournament_participant[]

  @@index([status], map: "idx_tournament_status")
}

model tournament_team {
  id                   String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tournament_id        String  @db.Uuid
  team_id              String  @db.Uuid
  advanced_to_quarters Boolean @default(false)

  tournament tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  team       team       @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, team_id])
}

model matchday {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tournament_id String   @db.Uuid
  name          String   @db.VarChar(100)
  date          DateTime @db.Date
  status        String   @default("open") @db.VarChar(15)
  total_pool    Decimal  @default(0.00) @db.Decimal(12, 2)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  tournament tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  matches    match[]
  tickets    ticket[]

  @@index([tournament_id], map: "idx_matchday_tournament")
  @@index([status], map: "idx_matchday_status")
}

model match {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchday_id String    @db.Uuid
  team_a_id   String    @db.Uuid
  team_b_id   String    @db.Uuid
  match_date  DateTime  @db.Timestamptz(6)
  status      String    @default("scheduled") @db.VarChar(15)
  score_a     Int?
  score_b     Int?
  result      String?   @db.VarChar(5)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  matchday     matchday      @relation(fields: [matchday_id], references: [id], onDelete: Cascade)
  team_a       team          @relation("team_a", fields: [team_a_id], references: [id])
  team_b       team          @relation("team_b", fields: [team_b_id], references: [id])
  ticket_picks ticket_pick[]

  @@index([matchday_id], map: "idx_match_matchday")
}

model ticket {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String   @db.Uuid
  matchday_id        String   @db.Uuid
  amount_bet         Decimal  @db.Decimal(12, 2)
  pool_contribution  Decimal  @db.Decimal(12, 2)
  total_correct      Int?
  status             String   @default("active") @db.VarChar(15)
  prize_won          Decimal? @default(0.00) @db.Decimal(12, 2)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  user         user          @relation(fields: [user_id], references: [id])
  matchday     matchday      @relation(fields: [matchday_id], references: [id])
  ticket_picks ticket_pick[]

  @@index([user_id], map: "idx_ticket_user")
  @@index([matchday_id], map: "idx_ticket_matchday")
}

model ticket_pick {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticket_id  String   @db.Uuid
  match_id   String   @db.Uuid
  pick       String   @db.VarChar(5)
  is_correct Boolean?

  ticket ticket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  match  match  @relation(fields: [match_id], references: [id])

  @@unique([ticket_id, match_id])
  @@index([ticket_id], map: "idx_ticketpick_ticket")
}

model tournament_group {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tournament_id   String    @db.Uuid
  name            String    @db.VarChar(100)
  team_ids        String[]  @db.Uuid
  has_third_place Boolean   @default(false)
  pts_1st         Int       @default(10)
  pts_2nd         Int       @default(5)
  pts_3rd         Int?
  pts_4th         Int?
  status          String    @default("open") @db.VarChar(15)
  result_1st      String?   @db.Uuid
  result_2nd      String?   @db.Uuid
  result_3rd      String?   @db.Uuid
  result_4th      String?   @db.Uuid
  total_pool      Decimal   @default(0.00) @db.Decimal(12, 2)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  tournament  tournament  @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  group_bets  group_bet[]

  @@index([tournament_id], map: "idx_group_tournament")
}

model group_bet {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String   @db.Uuid
  group_id           String   @db.Uuid
  pick_1st           String   @db.Uuid
  pick_2nd           String   @db.Uuid
  pick_3rd           String?  @db.Uuid
  pick_4th           String?  @db.Uuid
  amount_bet         Decimal  @db.Decimal(12, 2)
  pool_contribution  Decimal  @db.Decimal(12, 2)
  total_points       Int?
  status             String   @default("active") @db.VarChar(15)
  prize_won          Decimal? @default(0.00) @db.Decimal(12, 2)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  user  user             @relation(fields: [user_id], references: [id])
  group tournament_group @relation(fields: [group_id], references: [id])

  @@index([user_id], map: "idx_groupbet_user")
  @@index([group_id], map: "idx_groupbet_group")
}

model transaction {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar(15)
  amount     Decimal  @db.Decimal(12, 2)
  status     String   @default("pending") @db.VarChar(15)
  proof_url  String?  @db.VarChar(500)
  notes      String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  user user @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_transaction_user")
  @@index([type], map: "idx_transaction_type")
  @@index([status], map: "idx_transaction_status")
}

model qr_code {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  image_url  String   @db.VarChar(500)
  label      String   @db.VarChar(100)
  is_active  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model news_cache {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  articles   Json     @db.JsonB
  cached_at  DateTime @default(now()) @db.Timestamptz(6)
}

model tournament_participant {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String   @db.Uuid
  tournament_id String   @db.Uuid
  status        String   @default("pending") @db.VarChar(15)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  user       user       @relation(fields: [user_id], references: [id])
  tournament tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)

  @@unique([user_id, tournament_id])
  @@index([user_id], map: "idx_tp_user")
  @@index([tournament_id], map: "idx_tp_tournament")
  @@index([status], map: "idx_tp_status")
}

model push_token {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token       String   @unique
  user_id     String   @db.Uuid
  device_type String?  @db.VarChar(20)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_pushtoken_user")
}

// ─── Audit log: registra acciones sensibles (admin, login, cambios de rol) ──
model audit_log {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String?  @db.Uuid           // quién hizo la acción (null si anónimo)
  action       String   @db.VarChar(50)    // 'login.success' | 'login.failed' | 'admin.create_tournament' | etc.
  target_type  String?  @db.VarChar(50)    // 'user' | 'tournament' | 'team' | etc.
  target_id    String?  @db.VarChar(100)
  ip           String?  @db.VarChar(45)
  user_agent   String?  @db.VarChar(255)
  metadata     Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id,  created_at], map: "idx_audit_user")
  @@index([action,   created_at], map: "idx_audit_action")
  @@index([created_at],            map: "idx_audit_time")
}

model app_setting {
  key       String @id @db.VarChar(100)
  value     String @db.Text
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

// ─── Notificaciones programadas ─────────────────────────────────────────────
//  kind = "pre_match"  → offset_minutes antes del inicio de cada partido
//          - target='non_bettors' (recomendado): solo usuarios del torneo
//            que aún no apostaron en esa jornada
//          - target='tournament_participants': todos los inscritos
//          - target='all': broadcast (raro para este kind)
//  kind = "cron"       → cron_expr estándar (ej. "0 9 * * *" = 9:00 diario)
//          - target='all': broadcast a TODOS los usuarios con push token
model notification_schedule {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String    @db.VarChar(100)
  enabled        Boolean   @default(true)
  kind           String    @db.VarChar(20)   // "pre_match" | "cron"
  offset_minutes Int?      // solo si kind="pre_match"
  cron_expr      String?   @db.VarChar(50)   // solo si kind="cron"
  title          String    @db.VarChar(80)
  body           String    @db.Text
  target         String    @default("non_bettors") @db.VarChar(30)
  last_run_at    DateTime? @db.Timestamptz(6)
  last_sent_count Int?     @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  match_reminder_logs match_reminder_log[]

  @@index([enabled, kind], map: "idx_notif_schedule_enabled_kind")
}

// Evita enviar 2 veces el mismo aviso pre-match para el mismo partido.
model match_reminder_log {
  match_id    String @db.Uuid
  schedule_id String @db.Uuid
  sent_at     DateTime @default(now()) @db.Timestamptz(6)
  sent_count  Int      @default(0)

  schedule notification_schedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@id([match_id, schedule_id])
  @@index([sent_at], map: "idx_match_reminder_sent")
}

model final_bet {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String   @db.Uuid
  tournament_id String   @db.Uuid
  pick_1st      String?  @db.Uuid
  pick_2nd      String?  @db.Uuid
  pick_3rd      String?  @db.Uuid
  pick_4th      String?  @db.Uuid
  total_points  Int      @default(0)
  status        String   @default("active") @db.VarChar(15)
  prize_won     Decimal  @default(0.00) @db.Decimal(12, 2)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  user       user       @relation(fields: [user_id], references: [id])
  tournament tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)

  @@unique([user_id, tournament_id])
  @@index([user_id], map: "idx_finbet_user")
  @@index([tournament_id], map: "idx_finbet_tournament")
}

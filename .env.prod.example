# ─────────────────────────────────────────────────────────────────────────
#  PRODUCTION SECRETS — DO NOT COMMIT
#  Copia este archivo a .env.prod y rellena los valores reales.
#  .env.prod debe estar en .gitignore (ya lo está).
# ─────────────────────────────────────────────────────────────────────────

# ── Postgres ──
POSTGRES_USER=mundial_admin
# Genera con: openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_PASSWORD_LARGA_Y_ALEATORIA
POSTGRES_DB=mundial2026

# ── JWT ──
# Genera con: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRES_IN=7d

# ── CORS ──
# Lista separada por comas de los origenes permitidos. NO uses "*" en prod.
# Ejemplo: https://mundial2026.example.com,https://www.mundial2026.example.com
CORS_ORIGINS=https://mundial.esppapel.com

# ── URL pública (se hornea en el bundle del frontend en build time) ──
PUBLIC_API_URL=https://mundial.esppapel.com

# ── Backup encryption ──
# Genera con: openssl rand -base64 32 — guárdalo en un gestor de contraseñas
BACKUP_GPG_PASSPHRASE=CAMBIA_ESTO_PARA_CIFRAR_BACKUPS

# ── Dominio + email para Let's Encrypt ──
DOMAIN=mundial.esppapel.com
LETSENCRYPT_EMAIL=tu-email@example.com

# ── Web Push (VAPID) ──
# Genera con:  npx web-push generate-vapid-keys
# Pública: la usa el navegador. Privada: solo el backend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@example.com

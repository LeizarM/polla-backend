# ────────────────────────────────────────────────────────────────────────
# Backend (NestJS) — production multi-stage build
#   - Stage 1: build TS → dist
#   - Stage 2: only deps + dist + non-root user
# ────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

RUN apk add --no-cache openssl
WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma/ ./prisma/
# --legacy-peer-deps: tolera resoluciones de peer deps no estrictas
# (común cuando libs aún no marcan soporte para NestJS 11 aunque funcionen)
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

RUN npx prisma generate

COPY . .
RUN npm run build

# Drop dev deps for the runtime image
RUN npm prune --omit=dev

# ────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

RUN apk add --no-cache openssl tini && \
    addgroup -S app && adduser -S app -G app

WORKDIR /app

# Copy only what's needed
COPY --from=builder --chown=app:app /app/node_modules ./node_modules
COPY --from=builder --chown=app:app /app/dist         ./dist
COPY --from=builder --chown=app:app /app/prisma       ./prisma
COPY --from=builder --chown=app:app /app/package.json ./package.json

USER app

ENV NODE_ENV=production
# Build-arg desde CI: el SHA queda en la imagen y lo expone /health
ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA
EXPOSE 3000

# tini → proper signal handling for graceful shutdown
ENTRYPOINT ["/sbin/tini", "--"]

# Run pending migrations once (idempotent), then start the server
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
